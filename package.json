{
  "name": "converter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Quick weight, height and BMI conversions as an offline PWA",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "./scripts/e2e-docker.sh",
    "test:e2e:update": "./scripts/e2e-docker.sh --update-snapshots",
    "test:e2e:native": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  }
}
